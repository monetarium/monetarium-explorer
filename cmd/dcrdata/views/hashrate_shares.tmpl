{{define "hashrate_shares"}}
<!DOCTYPE html>
<html lang="en">
{{template "html-head" headData .CommonPageData "Monetarium Hashrate Shares"}}
    {{template "navbar" . }}

    <main data-controller="hashrate-shares" class="container main">

        <div class="d-flex flex-wrap justify-content-center align-items-center chart-controls mb-1 mt-1">
            <div class="chart-control-wrapper me-2 mb-1">
                <div class="chart-control-label">CHART</div>
                <div class="chart-control">
                    <select
                        id="selectBox"
                        class="form-control chart-form-control dropdown"
                        data-action="hashrate-shares#selectChart"
                    >
                        <option value="ticket-price">Ticket Price</option>
                        <option value="ticket-pool-size">Ticket Pool Size</option>
                        <option value="ticket-pool-value">Ticket Pool Value</option>
                        <option value="stake-participation">Stake Participation</option>
                        <option value="block-size">Block Size</option>
                        <option value="blockchain-size">Blockchain Size</option>
                        <option value="tx-count">Transaction Count</option>
                        <option value="pow-difficulty">PoW Difficulty</option>
                        <option value="coin-supply/0">Circulation (VAR)</option>
                        {{range $t := .ActiveSKATypes}}<option value="coin-supply/{{$t}}">Circulation (SKA{{$t}})</option>
                         {{end}}<option value="fees">Fees (VAR)</option>
                         {{range $t := .ActiveSKATypes}}<option value="fees/{{$t}}">Fees (SKA{{$t}})</option>
                          {{end}}
                         <option value="duration-btw-blocks">Duration Between Blocks</option>
                        <option value="chainwork">Total Work</option>
                        <option value="hashrate">Hashrate</option>
                        <option value="hashrate-shares" selected>Hashrate Shares</option>
                        <option value="missed-votes">Missed Votes</option>
                    </select>
                </div>
            </div>

            <div class="chart-control-wrapper me-2 mb-1">
                <div class="chart-control-label">INTERVAL</div>
                <div class="chart-control">
                    <ul class="nav nav-pills">
                        <li class="nav-item nav-link" data-hashrate-shares-target="intervalOption"
                            data-action="click->hashrate-shares#setInterval" data-option="all">All</li>
                        <li class="nav-item nav-link" data-hashrate-shares-target="intervalOption"
                            data-action="click->hashrate-shares#setInterval" data-option="year">Year</li>
                        <li class="nav-item nav-link" data-hashrate-shares-target="intervalOption"
                            data-action="click->hashrate-shares#setInterval" data-option="month">Month</li>
                        <li class="nav-item nav-link active" data-hashrate-shares-target="intervalOption"
                            data-action="click->hashrate-shares#setInterval" data-option="week">Week</li>
                        <li class="nav-item nav-link" data-hashrate-shares-target="intervalOption"
                            data-action="click->hashrate-shares#setInterval" data-option="day">Day</li>
                    </ul>
                </div>
            </div>

            <div class="chart-control-wrapper me-2 mb-1">
                <div class="chart-control-label">BLOCK RANGE</div>
                <div class="chart-control">
                    <div class="d-flex align-items-center gap-1 flex-wrap" data-hashrate-shares-target="blockRangeWrap">
                        <span class="text-secondary fs12">From</span>
                        <input type="number" min="0"
                               class="form-control form-control-sm" style="width: 6em;"
                               data-hashrate-shares-target="fromInput" placeholder="1000">
                        <span class="text-secondary fs12">To</span>
                        <input type="number" min="0"
                               class="form-control form-control-sm" style="width: 6em;"
                               data-hashrate-shares-target="toInput" placeholder="2000">
                        <a class="btn btn-sm btn-primary" href="#"
                           data-action="click->hashrate-shares#applyBlockRange">Apply</a>
                    </div>
                    <div class="text-secondary fs12 mt-1">Range includes blocks from and to.</div>
                </div>
            </div>
        </div>

        <p class="hashrate-shares-heading text-center text-secondary fs15">
            Network hashrate shares, approximated from PoW reward (coinbase) transactions,
            per <strong>reward address</strong>. An operator using multiple payout addresses
            will appear as multiple separate entries.
        </p>

        <div class="d-hide text-secondary fs12 text-center mb-2" data-hashrate-shares-target="truncatedNote">
            The requested range extends past the current chain tip; showing blocks up to the tip only.
        </div>

        <div class="hashrate-shares-layout d-flex flex-wrap justify-content-center align-items-start">
            <div class="hashrate-shares-pie-wrap" data-hashrate-shares-target="pieWrap">
                <svg data-hashrate-shares-target="pie" viewBox="0 0 360 360" class="hashrate-shares-pie"></svg>
            </div>
            <div class="hashrate-shares-table-wrap">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-secondary fs12">Filter by address</span>
                    <input type="text" class="form-control form-control-sm"
                           style="max-width: 16em;"
                           data-hashrate-shares-target="addressInput"
                           data-action="input->hashrate-shares#filterByAddress"
                           placeholder="Search reward address…" autocomplete="off">
                </div>
                <div class="hashrate-shares-scroll">
                    <table class="table table-sm hashrate-shares-table">
                        <thead>
                            <tr>
                                <th class="text-end">#</th>
                                <th></th>
                                <th class="text-end">%</th>
                                <th class="text-end">Blocks</th>
                                <th class="text-end">Miner Reward</th>
                                <th class="text-end">Fees</th>
                                <th>Reward Address</th>
                            </tr>
                        </thead>
                        <tbody data-hashrate-shares-target="tableBody"></tbody>
                        <tfoot data-hashrate-shares-target="totalsRow" class="hashrate-shares-totals d-hide">
                            <tr>
                                <td>Totals</td>
                                <td></td>
                                <td></td>
                                <td class="text-end" data-type="totalsBlocks"></td>
                                <td class="text-end" data-type="totalsReward"></td>
                                <td class="text-end" data-type="totalsFees"></td>
                                <td data-type="totalsAddr"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="d-hide text-secondary p-3" data-hashrate-shares-target="empty">
                    No PoW Reward transactions in the selected period.
                </div>
                {{/* Download CSV — exports the full per-miner list (not the capped
                     top-25 + "Others" view). The wrapper hides with the table when
                     the period is empty (the controller toggles d-hide), so the
                     link only shows when there is data to export. The CSV is built
                     client-side from the full ranked list, so this is a JS action,
                     not a server download URL. */}}
                <div class="d-flex justify-content-end align-items-center d-hide" data-hashrate-shares-target="downloadWrap">
                    <a class="d-inline-block p-2 rounded download text-nowrap" href="#"
                       data-action="click->hashrate-shares#downloadCsv">
                        <span class="monicon-download mx-1"></span> Download CSV
                    </a>
                </div>
            </div>
        </div>

        {{/* Row template cloned per miner by the hashrate-shares controller. */}}
        <template data-hashrate-shares-target="rowTemplate">
            <tr>
                <td class="text-end" data-type="rank"></td>
                <td><span class="hashrate-shares-swatch" data-type="swatch"></span></td>
                <td class="text-end mono" data-type="percent"></td>
                <td class="text-end mono" data-type="blocks"></td>
                <td class="text-end mono" data-type="minerReward"></td>
                <td class="text-end mono" data-type="fees"></td>
                <td class="position-relative clipboard hashrate-shares-addr" data-type="addr"></td>
            </tr>
        </template>
    </main>

{{ template "footer" . }}
</body>
</html>
{{end}}
